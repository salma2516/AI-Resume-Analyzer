# ==========================================
# AI Resume Analyzer - Environment Template
# ==========================================

# Application
APP_NAME=AI Resume Analyzer
APP_VERSION=1.0.0
HOST=127.0.0.1
PORT=8000

# ==========================================
# Database
# ==========================================
DATABASE_URL=sqlite:///./resume_analyzer.db

# ==========================================
# Security
# ==========================================
SECRET_KEY=change-this-to-a-random-secret-key

# ==========================================
# Google Authentication
# ==========================================
GOOGLE_CLIENT_ID=

# ==========================================
# Live Jobs - Disabled until Adzuna is configured
# ==========================================
LIVE_JOBS_ENABLED=false

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

LIVE_JOB_LOCATION=
LIVE_JOB_LIMIT=20
LIVE_JOB_MAX_DAYS=15
LIVE_JOB_CACHE_SECONDS=600
LIVE_JOB_RESULTS_PER_QUERY=20
LIVE_JOB_PAGES_PER_QUERY=3
LIVE_JOB_VALIDATE_URLS=true
LIVE_JOB_URL_TIMEOUT=5
LIVE_JOB_MIN_MATCH_SCORE=25
LIVE_JOB_ALLOW_STRETCH=true

# ==========================================
# Salary
# ==========================================
JOB_MIN_SALARY_INR=0
JOB_REQUIRE_SALARY=false

# ==========================================
# Local Job Database
# ==========================================
ALLOW_LOCAL_FALLBACK=false

# ==========================================
# Email
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_NAME=AI Resume Analyzer

# ==========================================
# Frontend
# ==========================================
VITE_GOOGLE_CLIENT_ID=
VITE_API_URL=http://127.0.0.1:8000