# =========================================================
# AI RESUME ANALYZER - ENVIRONMENT CONFIGURATION EXAMPLE
# =========================================================

# =========================================================
# APPLICATION
# =========================================================

APP_NAME=AI Resume Analyzer
APP_VERSION=1.0.0

HOST=127.0.0.1
PORT=8000


# =========================================================
# DATABASE
# =========================================================

DATABASE_URL=sqlite:///./resume_analyzer.db


# =========================================================
# SECURITY
# =========================================================

SECRET_KEY=your-secret-key-here


# =========================================================
# GOOGLE AUTHENTICATION
# =========================================================

GOOGLE_CLIENT_ID=your-google-client-id


# =========================================================
# LIVE JOB RECOMMENDATIONS
# =========================================================

LIVE_JOBS_ENABLED=true

ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

ADZUNA_COUNTRY=in

# Empty = search across India
LIVE_JOB_LOCATION=

# Maximum number of final recommendations
LIVE_JOB_LIMIT=20

# Only show jobs posted within the last 15 days
LIVE_JOB_MAX_DAYS=15

# Cache live results for 10 minutes
LIVE_JOB_CACHE_SECONDS=600

# Jobs fetched for each dynamic query
LIVE_JOB_RESULTS_PER_QUERY=20

# Number of pages to fetch per query
LIVE_JOB_PAGES_PER_QUERY=3

# Validate that application URLs are reachable
LIVE_JOB_VALIDATE_URLS=true

# URL validation timeout in seconds
LIVE_JOB_URL_TIMEOUT=5

# Minimum resume/job compatibility score
LIVE_JOB_MIN_MATCH_SCORE=25

# Allow reasonable stretch opportunities
LIVE_JOB_ALLOW_STRETCH=true


# =========================================================
# SALARY FILTERING
# =========================================================

# 0 = no minimum salary requirement
JOB_MIN_SALARY_INR=0

# false = allow jobs without disclosed salary
JOB_REQUIRE_SALARY=false


# =========================================================
# LOCAL JOB DATABASE FALLBACK
# =========================================================

# false = don't show old/static jobs when live jobs are unavailable
ALLOW_LOCAL_FALLBACK=false


# =========================================================
# EMAIL / APPLICATION TRACKING
# =========================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

SMTP_SENDER_NAME=AI Resume Analyzer


# =========================================================
# FRONTEND
# =========================================================

VITE_GOOGLE_CLIENT_ID=your-google-client-id

VITE_API_URL=http://127.0.0.1:8000